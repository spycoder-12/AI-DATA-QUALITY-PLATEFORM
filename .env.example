# Copy to .env and edit. Never commit .env (it is in .gitignore).

# SQLAlchemy URL. Leave empty to use the bundled SQLite file at data/platform.db
#   SQLite     : sqlite:///data/platform.db
#   PostgreSQL : postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME   (needs: pip install psycopg2-binary)
#   (URL-encode special characters in the password, e.g. @ -> %40)
DATABASE_URL=

# Reserved for signing / authentication extensions (not used by the current single-user build).
# Set a long random value anyway:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Storage locations (relative paths are resolved from the project root)
UPLOAD_DIR=data/uploads
PROCESSED_DIR=data/processed
REPORT_DIR=data/reports

# Maximum upload size. Accepts bytes or a suffix: 50MB, 200MB, 1GB
MAX_UPLOAD_SIZE=50MB

# Comma-separated list of allowed upload extensions
ALLOWED_EXTENSIONS=.csv,.xlsx,.xls,.pdf

# Comma-separated list of browser origins allowed to call the API (CORS)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Server
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
DEBUG=false
